# Environment Configuration Template for SentiNews Backend

# Node Environment
NODE_ENV=production

# Database (PostgreSQL / Neon / Supabase connection string)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="https://your-backend-app.vercel.app"

# Google OAuth (Optional - for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email SMTP Provider (Optional - for OTP verification and password reset)
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM="no-reply@sentinews.com"

# AI Sentiment Providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# News & External Integrations
POLYGON_API_KEY=""
NEWS_API_KEY=""

# Market Provider Integration ("upstox" | "alphavantage" | "finnhub" | "twelvedata" | "mock")
MARKET_PROVIDER="upstox"
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI=""
UPSTOX_ACCESS_TOKEN=""
ALPHAVANTAGE_API_KEY=""
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""
